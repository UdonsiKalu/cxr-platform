[Unit]
Description=NVIDIA GPU Research power limit (240 W) + persistence mode
Documentation=file:///home/udonsi-kalu/staging/cxr-ops-lab/docs/PERSISTENT-PORTS.md
# After driver / persistenced; still works if persistenced is absent
After=nvidia-persistenced.service multi-user.target
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/nvidia-gpu-power-limit
# Default Research profile (Workbench :8256); override WATTS in /etc/default/nvidia-gpu-power-limit
ExecStart=/bin/bash -c 'W="${WATTS:-240}"; /usr/bin/nvidia-smi -pm 1; /usr/bin/nvidia-smi -pl "$W"'
ExecStop=/bin/bash -c '/usr/bin/nvidia-smi -pl 370 || true'

[Install]
WantedBy=multi-user.target
