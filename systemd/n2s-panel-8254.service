[Unit]
Description=N2S diagnostic panel UI (port 8254)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/udonsi-kalu/staging/cxr-evidence-grounding-lab-panel
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 server.py
Restart=always
RestartSec=5
StandardOutput=append:/tmp/n2s-panel-8254.log
StandardError=append:/tmp/n2s-panel-8254.log

[Install]
WantedBy=cxr-lab.target
