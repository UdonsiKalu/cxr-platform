[Unit]
Description=N2S evidence-grounding lab UI (port 8253)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/udonsi-kalu/staging/cxr-evidence-grounding-lab
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 server.py
Restart=always
RestartSec=5
StandardOutput=append:/tmp/n2s-lab-8253.log
StandardError=append:/tmp/n2s-lab-8253.log

[Install]
WantedBy=cxr-lab.target
